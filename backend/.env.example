# ================================================
# VOLVEMOS — Variables de entorno
# ================================================
# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas .env a GitHub.
# ================================================

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_contraseña_aqui
DB_NAME=volvemos

# JWT — pon una cadena larga y aleatoria, por ejemplo:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=pon_aqui_una_clave_secreta_larga_y_aleatoria

# Puerto del servidor (opcional, por defecto 3000)
PORT=3000
