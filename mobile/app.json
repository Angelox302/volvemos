{
  "expo": {
    "name": "Volvemos",
    "slug": "volvemos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a1a2e"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#1a1a2e"
      },
      "package": "com.angelo.volvemos"
    },
    "scheme": "volvemos",
    "plugins": [
      "expo-router"
    ],
    "newArchEnabled": false,
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fda0b3e6-79ea-4ba2-934d-e122db0c030f"
      }
    }
  }
}
